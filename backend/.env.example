# --- core (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=datespark
JWT_SECRET=change-me-to-64-random-bytes        # rotating it signs everyone out
ANTHROPIC_API_KEY=                              # Claude (official SDK)
LLM_TIMEOUT_SECONDS=45

# --- first admin (created once if the address is unused; an existing account is never promoted)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- sign-in providers
APPLE_AUDIENCES=com.yourco.datespark            # bundle id(s); host.exp.Exponent is rejected unless ALLOW_EXPO_GO_AUDIENCE=1
GOOGLE_CLIENT_IDS=                              # comma-separated iOS/Android/Web OAuth client ids
# Sign in with Apple token revocation on account deletion (App Store 5.1.1(v)) — key from developer.apple.com
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=                                # usually the bundle id
APPLE_PRIVATE_KEY=                              # the .p8 contents; literal \n allowed

# --- email (verification codes, password reset)
EMAIL_PROVIDER=                                 # resend | outbox (store in Mongo, dev) | log
RESEND_API_KEY=
EMAIL_FROM=Date Spark <no-reply@yourdomain.com>

# --- places / routing (billed — also set quotas + budget alerts in Google Cloud)
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
ROUTES_DAILY_LIMIT=300

# --- network
TRUSTED_PROXY_HOPS=2                            # 0 when the app is reached directly
TRUST_CF_HEADER=0                               # 1 ONLY if the origin accepts traffic from Cloudflare alone
CORS_ORIGINS=                                   # web app origin(s); unset = any origin, no credentials

# --- RevenueCat server-side verification (runbook: memory/revenuecat_rollout_runbook.md)
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_ENVIRONMENT=PRODUCTION

# --- invitation links (served at /s/<id>, /.well-known/*)
APPLE_APP_ID=                                   # TEAMID.bundle.id
ANDROID_PACKAGE=
ANDROID_SHA256_FINGERPRINTS=
APP_STORE_URL=
PLAY_STORE_URL=
