# Backend origin (no trailing /api). Required — the app shows a configuration error without it.
EXPO_PUBLIC_BACKEND_URL=https://api.example.com

# RevenueCat public SDK keys. The test key is only used in development builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Google Sign-In OAuth client ids (the backend's GOOGLE_CLIENT_IDS must list the same ids). Unset = button hidden.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Legal pages (App Store 3.1.2 / 5.1.1). Privacy URL is required for store builds; terms default to Apple's EULA.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Public origin for invitation links, served by the backend (/s/<id> + /.well-known files).
EXPO_PUBLIC_SHARE_BASE_URL=

# Build-only (app.config.ts) — set in the EAS build profile, not shipped to the app.
IOS_BUNDLE_ID=
ANDROID_PACKAGE=
IOS_BUILD_NUMBER=
ANDROID_VERSION_CODE=
ANDROID_GOOGLE_MAPS_API_KEY=
