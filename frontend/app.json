{
  "expo": {
    "name": "Date Spark",
    "slug": "date-spark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datespark",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.vibefinder.rvztki",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find experiences and venues near you",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsFullAccessUsageDescription": "Add your planned Spark to your calendar with a reminder",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add your planned Spark to your calendar with a reminder"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF9F5"
      },
      "package": "com.emergent.vibefinder.rvztki",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F5"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find experiences and venues near you"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-calendar",
        {
          "calendarPermission": "Add your planned Spark to your calendar with a reminder"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}